# Local development keeps SQLite. Set DATABASE_URL on the hosted API so leads,
# wheel results, pages, and programs survive restarts and new deployments.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:6432/DB_NAME
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# The hosted database must be provisioned outside the deployed app files.
# After setting DATABASE_URL, run `npm run migrate:postgres` once to copy an
# existing local SQLite database into PostgreSQL.
